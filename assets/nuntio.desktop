[Desktop Entry]
Type=Application
Name=nuntio
GenericName=Terminal
Comment=A fast, GPU-rendered terminal emulator
TryExec=nuntio
Exec=nuntio
Icon=nuntio
Terminal=false
Categories=System;TerminalEmulator;
Keywords=shell;prompt;command;commandline;terminal;tty;pty;console;
StartupWMClass=nuntio
StartupNotify=true
# How xdg-terminal-exec passes a command and a directory.
X-TerminalArgExec=-e
X-TerminalArgDir=--working-directory=
