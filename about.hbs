<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>nuntio third-party licenses</title>
</head>
<body>
<h1>Third-party licenses</h1>
<p>nuntio is licensed under MIT or Apache-2.0. It includes the following open source software.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>License texts</h2>
{{#each licenses}}
<section>
<h3 id="{{id}}">{{name}}</h3>
<h4>Used by</h4>
<ul>
{{#each used_by}}
<li>{{#if crate.repository}}<a href="{{crate.repository}}">{{crate.name}} {{crate.version}}</a>{{else}}<a href="https://crates.io/crates/{{crate.name}}">{{crate.name}} {{crate.version}}</a>{{/if}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
</section>
{{/each}}
</body>
</html>
